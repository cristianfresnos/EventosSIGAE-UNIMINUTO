# ==============================================================================
# PLANTILLA DE CONFIGURACIÓN DE VARIABLES DE ENTORNO — EVENTOSSIGAE-UNIMINUTO
# Archivo: .env.example (PLANTILLA DOCUMENTAL)
# INSTRUCCIÓN: Copie este archivo como .env y configure los valores según su entorno.
# ADVERTENCIA CRÍTICA:
# - NUNCA incluya credenciales ni secretos institucionales reales en esta plantilla.
# - NUNCA suba el archivo .env real al repositorio de control de versiones.
# - Todos los valores aquí presentes son FICTICIOS y con fines estrictamente ilustrativos.
# ==============================================================================

# Entorno de ejecución: 'development' (desarrollo local) o 'production' (servidor de producción)
DJANGO_ENV=development

# Modo de depuración:
# - True: Exclusivo para desarrollo local.
# - False: OBLIGATORIO en producción (si se intenta DJANGO_ENV=production con DEBUG=True, el arranque fallará).
DEBUG=True

# Llave criptográfica secreta (Obligatoria en producción: cadena aleatoria de >= 50 caracteres).
# Generar en consola segura con: python -c "import secrets; print(secrets.token_urlsafe(50))"
# ADVERTENCIA: El valor a continuación es un ejemplo ficticio rechazado automáticamente en producción.
SECRET_KEY=EJEMPLO_FICTICIO_CLAVE_INSEGURA_SOLO_PLANTILLA_CAMBIAR_EN_PRODUCCION_2026_XYZ!

# Hosts autorizados (FQDN o IPs separadas por comas).
# En producción es OBLIGATORIO especificar los dominios exactos asignados por TI.
# 'eventos.uniminuto.edu.co' es un dominio de ejemplo PENDIENTE de asignación oficial.
ALLOWED_HOSTS=127.0.0.1,localhost

# Orígenes de confianza para validación CSRF en peticiones HTTPS
CSRF_TRUSTED_ORIGINS=https://eventos.uniminuto.edu.co

# ------------------------------------------------------------------------------
# CONEXIÓN A BASE DE DATOS
# ------------------------------------------------------------------------------
# Puede configurarse mediante DATABASE_URL (estándar 12-factor) o parámetros individuales.
# Si se deja vacía DATABASE_URL y DB_ENGINE no es postgresql, se usará SQLite local (db.sqlite3).

# Opción A (Recomendada): DATABASE_URL completa
# DATABASE_URL=postgresql://sigae_app_usuario_ficticio:CONTRASENA_COMPLEJA_FICTICIA@127.0.0.1:5432/sigae_production_db

# Opción B: Parámetros individuales
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=sigae_production_db
DB_USER=sigae_app_usuario_ficticio
DB_PASSWORD=DEFINIR_CONTRASENA_COMPLEJA_POSTGRESQL_EN_SERVIDOR_NO_USAR_ESTE_EJEMPLO
DB_HOST=127.0.0.1
DB_PORT=5432
DB_CONN_MAX_AGE=600

# ------------------------------------------------------------------------------
# SEGURIDAD HTTPS / COOKIES / SSL (Solo activar en producción tras verificar certificados)
# ------------------------------------------------------------------------------
# Redirección forzada de HTTP a HTTPS (mantener False en desarrollo)
SECURE_SSL_REDIRECT=False

# HSTS (HTTP Strict Transport Security):
# Mantener en 0 durante la fase de puesta en marcha. Solo cambiar a 31536000 (1 año) tras certificar estabilidad TLS.
SECURE_HSTS_SECONDS=0
SECURE_HSTS_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False

# Cabecera enviada por el proxy inverso Nginx (Activar True solo si Nginx envía X-Forwarded-Proto)
USE_X_FORWARDED_PROTO=False

# ------------------------------------------------------------------------------
# CORREO INSTITUCIONAL (Django 6.1 MAILERS / SMTP)
# ------------------------------------------------------------------------------
# En desarrollo se emplea console.EmailBackend para imprimir mensajes sin conectar a servidores reales.
DEFAULT_FROM_EMAIL=SIGAE UNIMINUTO <no-reply@uniminuto.edu.co>
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.office365.com
EMAIL_PORT=587
EMAIL_HOST_USER=cuenta_servicio_ficticia@uniminuto.edu.co
EMAIL_HOST_PASSWORD=DEFINIR_CONTRASENA_APLICACION_M365_EN_SERVIDOR_SECRETO
EMAIL_USE_TLS=True

# ------------------------------------------------------------------------------
# LOGGING Y REGISTRO DEL SISTEMA
# ------------------------------------------------------------------------------
LOG_LEVEL=INFO
DJANGO_LOG_LEVEL=INFO
